# =========================
# ShotTaker — .gitignore
# =========================

# All user-generated runtime data — never committed
user_data/

# PyInstaller build output
dist/
build/
*.spec.bak

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# Logs at root (legacy location — now in user_data/)
launch_error.log
